{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D8 Shuffler",
  "version": "0.1.0",
  "identifier": "fyi.dantheman.d8shuffler",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "D8 Shuffler",
        "width": 980,
        "height": 800,
        "minWidth": 860,
        "minHeight": 680,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
